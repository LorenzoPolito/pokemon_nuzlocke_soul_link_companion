{
	"name": "nuzlocke-soullink-companion",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint . && node scripts/check-messages.ts",
		"i18n:check": "node scripts/check-messages.ts",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"pokedex:fetch": "sh scripts/fetch-api-data.sh .cache/api-data",
		"pokedex:build": "node scripts/build-pokedex.ts --source .cache/api-data/data/api/v2 --out data/pokedex/pokedex.sqlite --commit $(git -C .cache/api-data rev-parse HEAD)"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.1",
		"@inlang/plugin-message-format": "^4.5.5",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@libsql/client": "^0.18.0",
		"drizzle-orm": "^0.45.4",
		"zod": "^4.6.7"
	}
}
