# Copy to .env for local development. Never commit .env or any real value.

# Directory of the local database file (the container image sets it to /data).
# DATA_DIR=./data

# Remote database (Turso). Set both or none; when set, the local file is not used.
# TURSO_URL=libsql://your-database.turso.io
# TURSO_TOKEN=

# Read-only Pokédex file, generated by `npm run pokedex:fetch && npm run pokedex:build`
# (the container image sets it to /app/pokedex/pokedex.sqlite and requires it).
# POKEDEX_PATH=./data/pokedex/pokedex.sqlite

# First administrator: required while the app has no administrator, created at startup.
# The password must be changed at the first sign-in. After that the variables are not needed.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Secret that signs sessions (at least 32 characters). When missing, one is generated
# and kept in DATA_DIR/auth-secret.
# AUTH_SECRET=

# Public address of the app and, behind a reverse proxy, trust of its forwarded headers.
# ORIGIN=https://nuzlocke.example.org
# TRUST_PROXY=true

# Folder with the SQL migrations (the container image sets it to /app/drizzle).
# MIGRATIONS_DIR=./drizzle
